teamTopology
  title Enabling team facilitating one team in each group

  group alpha "Alpha" {
    stream web    "Web"
    stream mobile "Mobile"
  }

  group beta "Beta" {
    stream portal "Partner Portal"
    stream api_gw "API Gateway"
  }

  group gamma "Gamma" {
    stream ops "Ops Console"
  }

  enabling coaching "Platform Coaching"

  coaching ~~> web
